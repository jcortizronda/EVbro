# EVBro settings. Fill in the first block; everything else has a sensible default inside docker-compose.yml.
# The full list of optional variables (polling intervals, MQTT, limits, Android app…) is in docs/deployment.md.

# Internal database password (you never type it; just make it long)
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Key that encrypts your Ebro password and PIN at rest. Generate one with:  openssl rand -base64 32
# Keep a copy OUTSIDE the server: without it the saved Ebro account cannot be read and must be connected again.
ENCRYPTION_KEY=

# Time zone for scheduled charging and the hours shown in the app (IANA name)
TIMEZONE=Europe/Madrid

# Port the app listens on (change it if 8080 is already taken on this machine)
WEB_PORT=8080

# Shown on the /legal page of this server: who runs it and how to contact them about personal data
LEGAL_OPERATOR=
LEGAL_CONTACT=

# ---- Behind an HTTPS reverse proxy (recommended; see the installation guide): remove the # and adjust ----
# COOKIE_SECURE=true
# BIND_ADDRESS=127.0.0.1
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# ---- Admin console (another port, local network only; NEVER behind the public proxy) ----
# ADMIN_BIND_ADDRESS=127.0.0.1    # the server's LAN IP to open it from another computer
# ADMIN_WEB_PORT=8082

# ---- Image to run: latest or a version tag such as v1.2.0 ----
# EVBRO_TAG=latest
